  <folder name="Motivation" id="id-f5d6a83a02884af48aa93f5a87f4be05" type="motivation">
    <element xsi:type="archimate:Stakeholder" name="Presidente da Organização" id="id-571e51eab24f422f8aa22b752d97ed1d"/>
    <element xsi:type="archimate:Driver" name="Eliminar Informalidade que causa Insatisfação com o Suporte Técnico" id="id-78a17227808c41f9b3afba6517e88e52"/>
    <element xsi:type="archimate:Goal" name="Aumentar a Satisfação do Cliente com o Serviço de Suporte" id="id-8c585b62242a45e5a77973e21e13d4e3"/>
    <element xsi:type="archimate:Goal" name="Manter o Elevado Desempenho no Atendimento ao Cliente" id="id-df4a9efe08b9498abab61a23f1fc3f31"/>
    <element xsi:type="archimate:Outcome" name="Retenção dos Clientes Atuais em 80% por ano" id="id-ef1a3c3d155d4bf6849c9122f82b53c4"/>
    <element xsi:type="archimate:Outcome" name="Crescer a Base de Clientes com Indicações dos Clientes Atuais (2% de Crescimento)" id="id-e880af0377e04826888fb6f234e9dffe"/>
    <element xsi:type="archimate:Outcome" name="Satisfação dos Clientes em Nível Elevado (satisfeitos por completo ou encantdos com o serviço de suporte)" id="id-b1d2cfe00f13472a88e1220717591ca8"/>
    <element xsi:type="archimate:Assessment" name="Pesquisa de Satisfação vinculada com o Registro de Cada Chamada de Suporte Atendido" id="id-6f45d93918514ab9b4e0824e01570312"/>
    <element xsi:type="archimate:Assessment" name="Rewlatórios de Resultados em um Sistema de Gerenciamento de Vendas" id="id-c263192b6691457ca68dc93556a31844"/>
    <element xsi:type="archimate:Requirement" name="Relatório com a Lista de Clientes que Cancelaram Contrato" id="id-21c97121a9724929ba397821c7613845"/>
    <element xsi:type="archimate:Requirement" name="Dashboard de % de Retenção da Base de Clientes no Ano" id="id-e5af0c3d2ccc425ab5aa20fc3ebbe73a"/>
    <element xsi:type="archimate:Requirement" name="Relatório de Leads de Novos Clientes pelos Clientes Anuais" id="id-d5019e59da49465e8cfa2f0b9a8e05d5"/>
    <element xsi:type="archimate:Requirement" name="Gráfico de Crescimento/Descrescimento de Vendas por  mês com o % de novos clientes indcados sobre o total de clientes" id="id-ee4ca533bfbf485bb8debe59a9210c45"/>
    <element xsi:type="archimate:Requirement" name="Enciar pesquisa de Satisfação para o Cliente após o Fechamento do Chamado por um Técnico" id="id-73f901bffeaa42a8ab800a15d6fe2d81"/>
    <element xsi:type="archimate:Requirement" name="Relatório de Nota Média de Satisfação dos Clientes Por Tipo de Chamado Atendido" id="id-93d265dcb9044184a948b99f9974def9"/>
  </folder>
